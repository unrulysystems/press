{
  "name": "press",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "nub scripts/setup.ts",
    "build": "nub run -r --filter './packages/*' build && nub run -r --filter './apps/*' build",
    "typecheck": "tsgo -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "nub run typecheck && nub run lint && nub run format:check",
    "test": "bun test packages",
    "e2e": "bun scripts/e2e.ts",
    "localnet": "nub run --filter @press/core build && bun scripts/localnet.ts",
    "knip": "knip",
    "jscpd": "jscpd .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "nub run build && changeset publish"
  },
  "dependencies": {
    "@press/core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.7",
    "@typescript/native-preview": "^7.0.0-dev.20260628.1",
    "jscpd": "^4.2.5",
    "knip": "^5.88.1",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.3",
    "zshy": "^0.7.3"
  }
}
