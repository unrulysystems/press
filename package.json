{
  "name": "press",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "build:web": "bun run --filter @press/web build",
    "typecheck": "tsgo -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "bun run --filter @press/core build && bun test packages apps/web/src scripts",
    "build:cli:binary": "bun scripts/buildCliBinary.ts",
    "test:cli:binary": "bun scripts/verifyCliBinary.ts",
    "package:cli:release": "bun scripts/packageCliRelease.ts",
    "e2e": "bun run build:cli:binary && bun scripts/e2e.ts",
    "walkthrough": "bun run build:cli:binary && bun scripts/agentWalkthrough.ts",
    "drill:backup-restore": "bun run --filter @press/core build && bun scripts/backupRestoreDrill.ts",
    "smoke:image": "bun scripts/smokeImage.ts",
    "dev:share": "bun run --filter @press/core build && bun scripts/devShare.ts",
    "dev:share:smoke": "bun run build:cli:binary && bun scripts/devShareSmoke.ts",
    "localnet": "bun run --filter @press/core build && TILT_EDITOR=true silo up main",
    "knip": "knip",
    "jscpd": "jscpd .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "@press/cli": "workspace:*",
    "@press/core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.61.1",
    "@types/bun": "1.4.3",
    "@types/node": "26.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.7",
    "@typescript/native-preview": "^7.0.0-dev.20260628.1",
    "drizzle-kit": "^0.31.10",
    "jscpd": "^4.2.5",
    "knip": "^5.88.1",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.3",
    "zshy": "^0.7.3"
  },
  "packageManager": "bun@1.4.3"
}
