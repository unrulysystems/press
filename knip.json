{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "vite": false,
  "ignoreBinaries": ["silo"],
  "ignoreDependencies": [
    "@press/cli",
    "@fontsource/inter",
    "@fontsource/newsreader",
    "@tamagui/config"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "e2e/*.ts"],
      "project": ["scripts/**/*.ts", "e2e/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "app/**/*.tsx",
        "app/**/*+api.ts",
        "src/setupServer.ts",
        "src/publish/e2eSupport.ts",
        "vite.config.ts",
        "tamagui.config.ts"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx", "app/**/*.ts", "app/**/*.tsx"]
    }
  },
  "ignoreExportsUsedInFile": true
}
